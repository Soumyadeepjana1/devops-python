{
    // Python Interpreter & Analysis
    "python.defaultInterpreterPath": "/usr/bin/python3",
    "python.languageServer": "None",
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.autoImportCompletions": true,
    "python.terminal.activateEnvironment": true,
    "python.terminal.executeInFileDir": true,
    "python.formatting.provider": "ruff",

    // Icon Theme
    "workbench.iconTheme": "material-icon-theme",

    // Code Formatting & Linting (PEP 8)
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },

    // Shell Script Formatting for DevOps
    "[shellscript]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "foxundermoon.shell-format"
    },

    // YAML Formatting for DevOps (Docker, Kubernetes)
    "[yaml]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },

    // Dockerfile Formatting
    "[dockerfile]": {
        "editor.formatOnSave": true
    },

    // Indentation, Brackets & Visual Guides
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.indentation": true,
    "editor.renderWhitespace": "selection",
    "editor.rulers": [88],

    // Indent Rainbow Configuration
    "indentRainbow.includedLanguages": ["python", "shellscript", "yaml"],
    "indentRainbow.indicatorStyle": "classic",

    // Auto Docstring (Google Style)
    "autoDocstring.docstringFormat": "google",

    // File Management
    "files.autoSave": "afterDelay",
    "files.exclude": {
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/.venv": true,
        "**/venv": true,
        "**/.env": true
    },

    // DevOps & Cloud specific settings
    "files.associations": {
        "*.dockerfile": "dockerfile",
        "Dockerfile*": "dockerfile",
        "docker-compose*.yml": "yaml",
        "docker-compose*.yaml": "yaml",
        "*.tf": "hcl",
        "*.hcl": "hcl"
    },

    // Code Runner Configuration
    "code-runner.executorMap": {
        "python": "python3 -u",
        "python3": "python3 -u"
    },
    "code-runner.executorMapByFileExtension": {
        ".py": "python3 -u"
    },
    "code-runner.runInTerminal": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.clearPreviousOutput": true,
    "code-runner.showExecutionMessage": true,
    "code-runner.ignoreSelection": true
}
